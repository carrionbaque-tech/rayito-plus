{
  "name": "rayito-exe",
  "version": "1.0.2",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "publish": "electron-builder --win --publish always"
  },
  "keywords": [],
  "author": "carrionbaque-tech",
  "license": "ISC",
  "description": "Rayito Plus Desktop",
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "electron-log": "^5.2.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.3.9",
    "firebase": "^12.19.0",
    "hls.js": "^1.7.3"
  },
  "build": {
    "appId": "com.rayitoplus.rayitoplus",
   "productName": "Rayito-Plus",
    "publish": [
      {
        "provider": "github",
        "owner": "carrionbaque-tech",
        "repo": "rayito-plus",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rayito Plus"
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/.bin",
      "!**/*.map",
      "!**/{.git,.github,.vscode,.idea}"
    ]
  }
}